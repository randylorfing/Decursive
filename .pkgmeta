# vim:syntax=YAML:expandtab
# Rebuild is a single addon folder (ZDecursive/). package-as stages the
# checkout one level under that name, so the self-referencing move-folders
# entry is required or ZDecursive.toc lands at
# ZDecursive/ZDecursive/ZDecursive.toc and WoW will not load it.
package-as: ZDecursive

move-folders:
    ZDecursive/ZDecursive: ZDecursive

# Ignore paths are relative to the REPO ROOT. With package-as: ZDecursive,
# anything left at the root ships inside the addon unless listed here.
ignore:
    # Durable: any root markdown would ship inside the addon. README.md
    # is dropped by this glob; do not add a README exception.
    - "*.md"
    - LICENSE
    - .gitignore
    - .gitattributes
    - .editorconfig
    - .cursor
    - docs
    # Still ignore these under ZDecursive/; root *.md does not match nested paths.
    - CHANGELOG.md
    - OldChangeLog.md
    - WhatsNew.md
    - RELEASE_NOTES*.md
    - ZDecursive/CHANGELOG.md
    - ZDecursive/OldChangeLog.md
    - ZDecursive/WhatsNew.md
    - ZDecursive/RELEASE_NOTES*.md
    - ZDecursive/docs

# Libs are committed. Do not add externals; that collides with move-folders.
license-output: LICENSE.txt
