# vim:syntax=YAML:expandtab
# Multi-folder repo (Decursive core + Decursive_Options LoadOnDemand
# companion), packaged from one repo the same way DeadlyBossMods/
# DeadlyBossMods does it (DBM-Core + DBM-GUI/DBM-StatusBarTimers/etc. as
# sibling top-level folders, package-as the primary addon, move-folders to
# relocate the companion(s) into the final zip's top level).
package-as: Decursive

# The packager internally stages everything one level under package-as (so
# sibling folders can be relocated from there) -- the package-as folder
# itself ALSO needs an explicit entry to get un-nested back to the top
# level of the final zip, or Decursive.toc ends up at Decursive/Decursive/
# Decursive.toc and the addon won't load. Confirmed via DBM's own .pkgmeta,
# which has the exact same self-referencing DBM-Core/DBM-Core: DBM-Core
# entry for this reason.
move-folders:
    Decursive/Decursive: Decursive
    Decursive/Decursive_Options: Decursive_Options

# All Libs are committed directly to the repo (Decursive/Libs/*) rather than
# fetched as externals -- confirmed via `git ls-files`, every library the old
# externals list named is already tracked. Re-fetching them as externals at
# build time (the old convention) duplicated that same content at the same
# path, which is harmless for a single-folder package but breaks the
# move-folders self-reference above: mv can't merge a directory onto an
# existing same-named directory, so "Decursive/Decursive/Libs" colliding with
# externally-fetched "Decursive/Libs" produced a hard "Directory not empty"
# error. AceGUI-3.0/AceConfig-3.0 were the only externals NOT already
# tracked, and they're unused (v11's embeds.xml intentionally doesn't load
# them) -- dropped rather than kept as dead weight in the package.
# Ignore paths must be relative to the REPO ROOT, not to the addon folder --
# so they need the Decursive/ prefix in this multi-folder layout. The packager
# matches these as plain shell globs against the path it prints as
# "Copying: Decursive/branding/decursive-logo.jpg", and an unprefixed
# "branding" matched nothing: because $topdir/branding doesn't exist, the
# packager expanded it to "branding:branding/*", neither of which matches
# "Decursive/branding/...". Result: a 612 KB logo referenced by no code shipped
# in every release through v12.0.4, ~30% of the download. With the prefix the
# packager sees a real directory and expands it to "Decursive/branding/*".
# Verify after changing: the build log must say "Ignoring:", not "Copying:".
ignore:
    - Decursive/Libs/LibStub/tests
    - Decursive/branding
    # Repository-root documentation. With package-as: Decursive the packager
    # stages the whole checkout under the package folder, so anything left at
    # the repo root ships INSIDE the addon. README.md is doubly bad there: it
    # collides case-insensitively with the tracked Decursive/Readme.md, so a
    # Windows extraction prompts to overwrite. Shipped by mistake in v12.1.2.
    - README.md
    - RELEASE_PROCESS.md
    - AUDIT_RELEASE_READINESS.md
    # GitHub needs the repository-root GPL text for license discovery, but the
    # addon already ships LICENSE.txt in each packaged addon folder through
    # license-output below.
    - LICENSE
    - .gitattributes
    - .editorconfig
    - .docmeta
    - .cursor
    - Decursive/docs
    # Superseded release notes and development docs are source-only. They stay
    # in the repository as project history but have no business in a user's
    # AddOns folder, and shipping them only inflates the download.
    - Decursive/RELEASE_NOTES_v11*.md
    - Decursive/RELEASE_NOTES_v12.0*.md
    - Decursive/RELEASE_NOTES_v12.1.2.md
    - Decursive/RELEASE_NOTES_v12.1.3.md
    - Decursive/12_1_PATCH_NOTES.md
    - Decursive/IMPLEMENTATION_SUMMARY.md
    - Decursive/FULL_ENVIRONMENT_PROFILES.md
    - Decursive/V10.20_HOTFIX.md
    - Decursive/V10.41_12.1_SECRET_SAFETY.md
    - Decursive/Todo.txt
    - Decursive/Modern/V11_FEATURE_PARITY.md
    - Decursive/Modern/V11_REBUILD.md
    - Decursive/Modern/V11_UI_AUDIT.md

optional-dependencies:
    - bug-grabber

# No-op as configured, kept for when externals return. The packager only builds
# a nolib archive when $nolib_exclude is non-empty, and that is populated ONLY
# while processing an "externals" block (release.sh ~line 2335, gated ~2765).
# Every library here is committed to the repo rather than fetched as an
# external, so there is nothing to strip and a nolib zip would be byte-identical
# to the main one. Do NOT re-add externals just to make this produce a file --
# that reintroduces the Libs/ collision documented above.
enable-nolib-creation: yes

license-output: LICENSE.txt

# manual-changelog removed: the packager resolves its file path once, before
# move-folders runs, and never refreshes it -- after the self-referencing
# Decursive/Decursive: Decursive move relocates everything, the cached path
# points at a location that no longer exists, which broke the CurseForge
# upload's JSON payload (empty changelog -> "Missing field `metadata`") and
# the GitHub release creation entirely. DBM's .pkgmeta -- which has the same
# self-referencing move-folders entry -- doesn't use manual-changelog either,
# for the same reason. Falls back to the packager's own auto-generated
# commit-based changelog instead.

