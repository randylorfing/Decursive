# vim:syntax=YAML:expandtab
# Rebuild is a single addon folder (Decursive/). package-as stages the
# checkout one level under that name, so the self-referencing move-folders
# entry is required or Decursive.toc lands at
# Decursive/Decursive/Decursive.toc and WoW will not load it.
package-as: Decursive

move-folders:
    Decursive/Decursive: Decursive

# Ignore paths are relative to the REPO ROOT. With package-as: Decursive,
# anything left at the root ships inside the addon unless listed here.
ignore:
    # Durable: any root markdown would ship inside the addon. README.md
    # is dropped by this glob; do not add a README exception.
    - "*.md"
    - LICENSE
    - .gitignore
    - .gitattributes
    - .editorconfig
    - .cursor
    - docs
    # Still ignore these under Decursive/; root *.md does not match nested paths.
    - CHANGELOG.md
    - OldChangeLog.md
    - WhatsNew.md
    - RELEASE_NOTES*.md
    - Decursive/CHANGELOG.md
    - Decursive/OldChangeLog.md
    - Decursive/WhatsNew.md
    - Decursive/RELEASE_NOTES*.md
    - Decursive/docs

# Libs are committed. Do not add externals; that collides with move-folders.
license-output: LICENSE.txt
