# vim:syntax=YAML:expandtab
# Multi-folder repo (Decursive core + Decursive_Options LoadOnDemand
# companion), packaged from one repo the same way DeadlyBossMods/
# DeadlyBossMods does it (DBM-Core + DBM-GUI/DBM-StatusBarTimers/etc. as
# sibling top-level folders, package-as the primary addon, move-folders to
# relocate the companion(s) into the final zip's top level).
package-as: Decursive

move-folders:
    Decursive/Decursive_Options: Decursive_Options

externals:

    Libs/LibStub:
        url: https://repos.wowace.com/wow/libstub/trunk
    Libs/CallbackHandler-1.0:
        url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0

    Libs/AceAddon-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
    Libs/AceConsole-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
    Libs/AceEvent-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0

    Libs/AceTimer-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceTimer-3.0

    Libs/AceHook-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceHook-3.0
    Libs/AceDB-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
    Libs/LibDualSpec-1.0:
        url: https://repos.wowace.com/wow/libdualspec-1-0
    Libs/AceDBOptions-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
    Libs/AceLocale-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0

    Libs/AceGUI-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
    Libs/AceConfig-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0

    Libs/AceComm-3.0:
        url: https://repos.wowace.com/wow/ace3/trunk/AceComm-3.0

    Libs/BugGrabber:
        url: https://repos.wowace.com/wow/bug-grabber/trunk



    Libs/LibQTip-1.0:
        url: https://repos.wowace.com/wow/libqtip-1-0
    Libs/LibDBIcon-1.0:
        url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    Libs/LibDataBroker-1.1:
        url: https://github.com/tekkub/libdatabroker-1-1.git


ignore:
    - Libs/LibStub/tests
    - branding

optional-dependencies:
    - bug-grabber

enable-nolib-creation: yes

license-output: LICENSE.txt

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

