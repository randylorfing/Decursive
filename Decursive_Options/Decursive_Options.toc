# Load-on-demand companion. RequiredDeps + Decursive_ prefix nests under Decursive
# in the AddOns list. SavedVariables stay on the main Decursive.toc only.

# AceConfig-shaped option tree (defaults/handlers remain in Decursive/Dcr_opt.lua)
Dcr_opt_tree.lua

# Test Mode / live MUF preview chrome (defines ZD:BuildTestMode before panel)
TestMode\TestMode.lua

# Mature option model and native page builders. The legacy shell is replaced
# after load by V13\Shell.lua; these builders preserve complete feature access.
Modern\ZD_UI.lua
Modern\ZD_BlizzardSettings.lua

# v13 primary settings interface.
V13\Controls.lua
V13\Shell.lua
V13\Pages\Overview.lua
V13\Pages\MUFs.lua
V13\Pages\Cure.lua
V13\Pages\Alerts.lua
V13\Pages\Profiles.lua
V13\Pages\Settings.lua
